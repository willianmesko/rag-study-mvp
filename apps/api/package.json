{
  "name": "@rag-study/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test src/rag/chunk.test.ts src/application/use-cases/search-documents.test.ts src/application/use-cases/document-management.test.ts src/application/evaluation/golden-set.test.ts src/application/evaluation/prompt-injection-suite.test.ts src/application/policies/grounded-answer-policy.test.ts src/application/policies/lexical-query.test.ts src/domain/security/prompt-injection.test.ts src/domain/security/pii-redaction.test.ts src/infrastructure/jina/jina-reranker.test.ts src/infrastructure/langgraph/langgraph-rag-workflow.test.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "ingest": "tsx src/interfaces/cli/ingest.ts",
    "eval:golden": "tsx src/interfaces/cli/evaluate-golden-set.ts",
    "eval:golden:ci": "tsx src/interfaces/cli/evaluate-golden-set-ci.ts evals/golden-set.v1.json evals/corpus-manifest.v1.json",
    "eval:security": "tsx src/interfaces/cli/evaluate-prompt-injection.ts",
    "eval:promptfoo": "promptfoo eval -c evals/promptfoo/promptfooconfig.yaml --no-cache"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.990.0",
    "@fastify/multipart": "^10.1.7",
    "@fastify/rate-limit": "^10.3.0",
    "@langchain/langgraph": "^1.7.0",
    "@rag-study/contracts": "0.1.0",
    "@supabase/supabase-js": "^2.49.8",
    "dotenv": "^16.6.1",
    "fastify": "5.12.8",
    "langsmith": "^0.11.8",
    "mammoth": "^1.13.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.16.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.15.4",
    "promptfoo": "0.125.1",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
