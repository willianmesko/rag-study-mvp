# PostgreSQL launched by docker compose. Do not commit passwords or API keys.
DATABASE_URL=postgresql://rag:rag@localhost:5433/rag

# Providers can be selected independently. The default is entirely local with Ollama.
EMBEDDING_PROVIDER=ollama
CHAT_PROVIDER=ollama

# The current pgvector schema is vector(1024); changing this needs a migration and full reindex.
EMBEDDING_DIMENSIONS=1024

# Ollama serves models locally. Install it and pull both models before ingesting.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=mxbai-embed-large
OLLAMA_CHAT_MODEL=llama3.2

# OpenRouter is optional and uses one API key for model comparison. Do not commit it.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_API_KEY=replace-with-a-key-from-openrouter
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENROUTER_CHAT_MODEL=openai/gpt-4o-mini
# Additional models use CHAT_PROVIDER by default. An explicit provider can be
# configured per model when its server credentials and hosting are available.
# The browser sends only an alias from its workspace policy.
# CHAT_DEFAULT_MODEL_LABEL=GPT-4o mini
# CHAT_ADDITIONAL_MODELS=[{"id":"flash-lite","label":"Gemini 2.5 Flash-Lite","model":"google/gemini-2.5-flash-lite","inputCostPer1kUsd":0.0001,"outputCostPer1kUsd":0.0004}]
# Optional. Owners can run the faithfulness judge on the bundled public benchmark.
# EVAL_FAITHFULNESS_JUDGE_MODEL=openai/gpt-4.1-mini

# Reranking is a second retrieval stage. Keep it off for fully local study;
# run npm run eval:jina with a key before enabling Jina for workspace retrieval.
RERANKER_PROVIDER=none
RERANKER_CANDIDATE_MULTIPLIER=4
JINA_BASE_URL=https://api.jina.ai/v1
# JINA_API_KEY=replace-with-a-key-from-jina
JINA_RERANKER_MODEL=jina-reranker-v2-base-multilingual

# LangSmith tracing is optional. It is disabled until a project and API key are configured.
LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=replace-with-a-key-from-langsmith
LANGSMITH_PROJECT=rag-study-mvp

# AWS is only needed when either provider above is set to "bedrock".
# The AWS SDK uses its standard credential chain: AWS_PROFILE, environment variables,
# IAM Identity Center, ECS/EKS role, or an EC2 role. aws configure / aws sso login is enough locally.
AWS_REGION=us-east-1
AWS_PROFILE=default

BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_CHAT_MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0

PORT=3000
# Use 0.0.0.0 only behind an authenticated TLS reverse proxy in production.
HOST=127.0.0.1
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
RETRIEVAL_TOP_K=5
DAILY_TENANT_QA_LIMIT=200
DAILY_USER_QA_LIMIT=30
DAILY_ADMIN_UPLOAD_BYTES_LIMIT=20000000
SEMANTIC_CACHE_TTL_SECONDS=3600
SEMANTIC_CACHE_MINIMUM_SIMILARITY=0.96
# Character-based estimates for the low-cost demo; replace with provider prices.
ESTIMATED_INPUT_COST_PER_1K_USD=0.00015
ESTIMATED_OUTPUT_COST_PER_1K_USD=0.0006
USAGE_ALERT_THRESHOLD_USD=1
# Optional 32+ character secret used to hash anonymous quota keys.
# USAGE_HASH_SECRET=replace-with-a-long-random-value
# Each retriever returns more candidates; Reciprocal Rank Fusion combines both rankings.
HYBRID_VECTOR_CANDIDATE_MULTIPLIER=4
HYBRID_KEYWORD_CANDIDATE_MULTIPLIER=4
RRF_K=60
# Scores are corpus and model dependent. Calibrate this from the golden set.
RAG_MINIMUM_SCORE=0.3
# Agent safety budgets. These are enforced by code, not only by prompts.
AGENT_MAX_STEPS=8
AGENT_TIMEOUT_MS=30000
MCP_ENABLED=false
# Optional dedicated PostgreSQL login with SELECT-only grants for MCP tool data.
# MCP_READ_DATABASE_URL=postgresql://...
# Remote URL connections use Lumora consent + Supabase login, not a copied user JWT.
MCP_REMOTE_ENABLED=false
# MCP_PUBLIC_URL=https://your-api.example.com/mcp
# APP_BASE_URL=https://your-app.example.com
# Optional additional trusted browser origins for remote clients. Native clients
# normally omit Origin. Do not use a wildcard or trust arbitrary Origin values.
# MCP_REMOTE_ALLOWED_ORIGINS=https://your-trusted-assistant.example
MCP_CALLS_PER_MINUTE=10
MCP_CALLS_PER_DAY=400
MCP_PROVIDER_CALLS_PER_DAY=100
MCP_INPUT_TOKENS_PER_DAY=100000
MCP_USER_COST_USD_PER_DAY=0.01
MCP_WORKSPACE_COST_USD_PER_DAY=0.05
MCP_COST_USD_PER_CALL=0.005
MCP_CONCURRENT_PROVIDERS=2
AGENT_ACTIONS_ENABLED=false
# Only the separately launched approved-action worker receives this credential.
# AGENT_ACTIONS_DATABASE_URL=postgresql://...
CHAT_MAX_OUTPUT_TOKENS=500
# Auto routing reserves a conservative prompt-token budget across attempts.
CHAT_AUTO_MAX_TOTAL_INPUT_TOKENS=120000
# When omitted, the total Auto output budget defaults to two answer attempts.
# CHAT_AUTO_MAX_TOTAL_OUTPUT_TOKENS=1000
# Set true in production when every provider is verified to support the JSON contract.
REQUIRE_STRUCTURED_ANSWER=false
MAX_ESTIMATED_COST_USD_PER_REQUEST=0.05

# Per-IP limits for this single-node MVP. Use a shared store and identity-aware
# limiting when horizontally scaling production workloads.
RATE_LIMIT_MAX=60
QA_RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=60000
# Bounded upstream calls prevent an unavailable model provider from holding HTTP requests forever.
PROVIDER_TIMEOUT_MS=30000
SERVER_SHUTDOWN_TIMEOUT_MS=25000

# Optional: when set, every HTTP request must include this exact value in x-api-key.
# API_KEY=replace-with-a-long-random-value

# Public demo: visitors can only search and ask questions. Document ingestion
# requires x-admin-api-key and must be performed from a trusted terminal/CI job.
# DEMO_MODE=true
# ADMIN_API_KEY=replace-with-a-different-long-random-value
# ALLOWED_ORIGINS=https://your-project.pages.dev,https://rag.example.com

# Protected document administration. The browser uses only the publishable
# key; the backend verifies the Supabase session and its tenant membership.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_... # backend only; enables private original-file storage
# APP_BASE_URL=https://your-project.pages.dev # invite links return here; allow it in Supabase Auth Redirect URLs
# SUPABASE_UPLOAD_BUCKET=rag-originals
# DEFAULT_TENANT_ID=00000000-0000-4000-8000-000000000001 # demo workspace; do not accept this from browsers
# ADMIN_EMAILS=admin@example.com # legacy bootstrap only; memberships authorize access
# UPLOAD_MAX_BYTES=5000000
# INGESTION_WORKER_INTERVAL_MS=5000

# Enable local OCR after installing pdftoppm, Tesseract, and its language data.
# Docker API images already include the tools and enable OCR by default.
# PDF_OCR_ENABLED=true
# PDF_OCR_LANGUAGES=eng+por
# PDF_OCR_MAX_PAGES=8
# PDF_OCR_TIMEOUT_MS=45000


# Native encrypted PostgreSQL workflow recovery. Generate a key once; see docs/durable-workflows.md.
WORKFLOWS_ENABLED=false
# WORKFLOW_STATE_KEY=canonical-base64-32-byte-key
WORKFLOW_INGEST_MAX_COST_USD=0.1
WORKFLOW_EVAL_MAX_COST_USD=0.2
# Conservative reservation rates; configure these for your selected providers.
EMBEDDING_INPUT_COST_PER_1K_USD=0.001
EVAL_JUDGE_INPUT_COST_PER_1K_USD=0.001
EVAL_JUDGE_OUTPUT_COST_PER_1K_USD=0.005
# OpenRouter uses the selected chat model for private claim checks; other providers use extractive checks.
RAG_CLAIM_MODE=model

# Optional versioned writer keyring; retain the legacy key while old records/backups need it.
# See docs/operations/workflow-key-rotation.md. Never commit populated keys.
# WORKFLOW_STATE_KEYS={"key-id":"canonical-base64-32-byte-key"}
# WORKFLOW_STATE_ACTIVE_KEY_ID=key-id

# Safe manual OpenTelemetry; no hosted receiver is created by enabling this flag.
OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:14318
# OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://localhost:14318/v1/metrics
# OTEL_EXPORTER_OTLP_HEADERS=authorization=provider-specific-header-value

# Billing estimates are separate from conservative workflow budget reservations.
# Leave unset if pricing is unknown; native provider cost remains authoritative.
# EMBEDDING_LEDGER_INPUT_COST_PER_1K_USD=provider-price-per-1000-input-tokens
# JINA_INPUT_COST_PER_1K_USD=provider-price-per-1000-input-tokens

# Optional signed durable budget webhook, configured only on the backend.
# BUDGET_ALERT_WEBHOOK_URL=https://your-approved-receiver.example/budget
# BUDGET_ALERT_WEBHOOK_SECRET=replace-with-at-least-32-random-characters
