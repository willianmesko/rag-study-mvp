{
  "name": "rag-study-mvp",
  "version": "0.1.0",
  "private": true,
  "description": "A study-focused custom RAG MVP using TypeScript, pgvector and Amazon Bedrock.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "npm run dev:api",
    "dev:api": "npm run build:contracts && npm --workspace @rag-study/api run dev",
    "dev:web": "npm run build:contracts && npm --workspace @rag-study/web run dev",
    "start": "npm --workspace @rag-study/api run start",
    "build:contracts": "npm --workspace @rag-study/contracts run build",
    "build:api": "npm run build:contracts && npm --workspace @rag-study/api run build",
    "build:web": "npm run build:contracts && npm --workspace @rag-study/web run build",
    "build": "npm run build:api && npm run build:web",
    "typecheck": "npm run build:contracts && npm --workspace @rag-study/api run typecheck && npm --workspace @rag-study/web run typecheck",
    "test": "npm --workspace @rag-study/api run test",
    "test:ux": "playwright test",
    "mcp:build": "npm run build:api",
    "test:mcp:postgres": "npm run build:api && npm run db:migrate && npm --workspace @rag-study/api run test:mcp:postgres",
    "agent-actions:work": "sh scripts/start-agent-action-worker.sh",
    "test:embedding:index": "npm --workspace @rag-study/api run test:embedding:index",
    "db:migrate": "npm --workspace @rag-study/api run db:migrate",
    "ingest": "npm --workspace @rag-study/api run ingest",
    "embedding:index": "npm --workspace @rag-study/api run embedding:index --",
    "eval:golden": "npm --workspace @rag-study/api run eval:golden --",
    "eval:golden:ci": "npm --workspace @rag-study/api run eval:golden:ci --",
    "eval:security": "npm --workspace @rag-study/api run eval:security --",
    "eval:replay": "npm --workspace @rag-study/api run eval:replay --",
    "eval:approve-replay": "npm --workspace @rag-study/api run eval:approve-replay --",
    "eval:performance-gate": "npm --workspace @rag-study/api run eval:performance-gate --",
    "eval:regression": "npm --workspace @rag-study/api run eval:regression",
    "eval:jina": "npm --workspace @rag-study/api run eval:replay -- --jina",
    "eval:promptfoo": "npm --workspace @rag-study/api run eval:promptfoo",
    "eval:harness": "node scripts/run-evaluation-harness.mjs",
    "workflow:keys": "npm --workspace @rag-study/api run workflow:keys --",
    "integration:deliveries": "npm --workspace @rag-study/api run integration:deliveries --",
    "check:architecture": "npm run build:contracts && node scripts/check-architecture.mjs",
    "test:architecture": "node --test tests/architecture/architecture.test.mjs",
    "check:frontend-budget": "node scripts/frontend-performance.mjs",
    "test:frontend-budget": "node --test tests/frontend-performance/budget.test.mjs",
    "test:frontend-state": "node --test tests/frontend-state/location.test.mts",
    "test:runtime-artifacts": "node --test tests/build-artifacts/runtime.test.mjs"
  },
  "overrides": {
    "light-my-request": "6.6.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "dependency-cruiser": "18.7.2"
  }
}
