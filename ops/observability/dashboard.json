{
  "title": "Lumora operations",
  "uid": "lumora-operations",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "tags": ["lumora"],
  "panels": [
    {
      "id": 1,
      "title": "HTTP requests per second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "lumora-metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(status)(rate(lumora_http_requests_total[5m]))",
          "legendFormat": "{{model}} {{lumora_operation}} {{outcome}} {{source}} {{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "title": "HTTP latency p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "lumora-metrics"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,sum by(le)(rate(lumora_http_duration_seconds_bucket[5m])))",
          "legendFormat": "{{model}} {{lumora_operation}} {{outcome}} {{source}} {{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 3,
      "title": "Stage latency p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "lumora-metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,sum by(le,lumora_operation)(rate(lumora_operation_duration_seconds_bucket{lumora_kind=\"workflow.stage\"}[5m])))",
          "legendFormat": "{{model}} {{lumora_operation}} {{outcome}} {{source}} {{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 4,
      "title": "Stage outcomes",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "lumora-metrics"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(lumora_operation,outcome)(increase(lumora_operation_calls_total{lumora_kind=\"workflow.stage\"}[1h]))",
          "legendFormat": "{{model}} {{lumora_operation}} {{outcome}} {{source}} {{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 5,
      "title": "Failure reasons",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "lumora-metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(reason)(increase(lumora_operation_calls_total{outcome=\"failed\"}[1h]))",
          "legendFormat": "{{model}} {{lumora_operation}} {{outcome}} {{source}} {{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 6,
